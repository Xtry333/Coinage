{
    "name": "coinage-app",
    "version": "1.0.0",
    "license": "MIT",
    "packageManager": "yarn@4.18.1",
    "private": true,
    "author": "Michał Woźniak <xtry333@gmail.com>",
    "repository": "git@github.com:Xtry333/Coinage.git",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "nx": "nx",
        "dev": "run-p dev:api dev:webapp",
        "dev:api": "nx serve coinage-api",
        "dev:webapp": "nx serve coinage-webapp",
        "build": "nx run coinage-tools:docker-build",
        "build:pi": "nx run coinage-tools:docker-bundle-pi",
        "build:apps": "nx run-many --target=build --configuration=production",
        "build:api": "nx build coinage-api --configuration=production",
        "build:webapp": "nx build coinage-webapp --configuration=production",
        "build:docker": "nx run coinage-tools:docker-build",
        "docker:build-api": "nx run coinage-tools:docker-build-api",
        "docker:build-webapp": "nx run coinage-tools:docker-build-webapp",
        "docker:publish": "nx run coinage-tools:docker-publish",
        "docker:push-api": "nx run coinage-tools:docker-publish-api",
        "docker:push-webapp": "nx run coinage-tools:docker-publish-webapp",
        "docker:push": "nx run coinage-tools:docker-publish",
        "docker:buildx-api": "nx run coinage-tools:docker-build-api --platform=linux/arm64",
        "docker:buildx-webapp": "nx run coinage-tools:docker-build-webapp --platform=linux/arm64",
        "docker:buildx": "nx run coinage-tools:docker-build --platform=linux/arm64",
        "docker:buildx-push": "nx run coinage-tools:docker-publish",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:prod:pull": "docker compose --env-file .env.production -f docker-compose.prod.yml pull",
        "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --no-build",
        "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
        "docker:dev": "docker compose -p coinage-postgres-dev -f docker-compose.dev.yml up -d",
        "docker:dev:logs": "docker compose -p coinage-postgres-dev -f docker-compose.dev.yml logs -f coinage-db",
        "docker:dev:down": "docker compose -p coinage-postgres-dev -f docker-compose.dev.yml down",
        "db:dump": "node tools/db-dump.cjs",
        "test": "run-s test:api test:webapp test:tools",
        "test:api": "nx test coinage-api",
        "test:webapp": "nx test coinage-webapp",
        "test:tools": "nx test coinage-tools",
        "test:docker": "nx run coinage-tools:test-compose",
        "lint": "nx run-many --target=lint",
        "e2e": "nx e2e coinage-webapp-e2e",
        "affected:apps": "nx show projects --affected --type=app",
        "affected:libs": "nx show projects --affected --type=lib",
        "affected:build": "nx affected --target=build",
        "affected:e2e": "nx affected --target=e2e",
        "affected:test": "nx affected --target=test",
        "affected:lint": "nx affected --target=lint",
        "affected:dep-graph": "nx graph --affected",
        "affected": "nx affected",
        "eslint": "nx run-many --target=lint",
        "lint:styles": "stylelint \"**/*.{css,scss}\"",
        "eslint:fix": "nx run-many --target=lint --fix",
        "format": "nx format:write",
        "format:write": "nx format:write",
        "format:check": "nx format:check",
        "typeorm": "node -r dotenv/config -r ts-node node_modules/typeorm/cli-ts-node-commonjs -d packages/coinage-api/src/app/typeorm.config.ts",
        "migration:create": "typeorm migration:create",
        "migration:run": "yarn typeorm migration:run",
        "migration:generate": "typeorm migration:generate ./packages/coinage-api/src/database/migrations/migration",
        "migration:auto": "node -r dotenv/config -r ts-node node_modules/typeorm/cli-ts-node-commonjs -d packages/coinage-api/src/app/typeorm.config.ts migration:generate ./packages/coinage-api/src/database/migrations/migration",
        "update": "run-s update:latest format",
        "update:latest": "nx migrate latest",
        "dep-graph": "nx graph",
        "help": "nx help"
    },
