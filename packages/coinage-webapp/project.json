{
    "name": "coinage-webapp",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "packages/coinage-webapp/src",
    "prefix": "app",
    "tags": [],
    "targets": {
        "typecheck": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "ngc --project packages/coinage-webapp/tsconfig.app.json --noEmit"
            }
        },
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": {
                    "base": "dist/packages/coinage-webapp",
                    "browser": ""
                },
                "index": "packages/coinage-webapp/src/index.html",
                "browser": "packages/coinage-webapp/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "packages/coinage-webapp/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": ["packages/coinage-webapp/src/favicon.ico", "packages/coinage-webapp/src/assets"],
                "styles": ["node_modules/@ng-select/ng-select/themes/default.theme.css", "packages/coinage-webapp/src/styles.scss"],
                "scripts": [],
                "allowedCommonJsDependencies": ["validator"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "16kb",
                            "maximumError": "32kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            }
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "continuous": true,
            "defaultConfiguration": "development",
            "options": {
                "proxyConfig": "packages/coinage-webapp/proxy.conf.json",
                "buildTarget": "coinage-webapp:build:development"
            },
            "configurations": {
                "production": {
                    "buildTarget": "coinage-webapp:build:production"
                },
                "development": {
                    "buildTarget": "coinage-webapp:build:development"
                }
            },
            "readyWhen": {
                "signal": true
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "coinage-webapp:build"
            }
        }
    }
}
