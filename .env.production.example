COMPOSE_PROJECT_NAME="coinage-app"

# Copy to .env.production (Git-ignored). Never commit production secrets.
# Lowercase GitHub username/organization and the tag used by yarn docker:publish.
COINAGE_REGISTRY_USER="xtry333"
COINAGE_IMAGE_TAG=

# PostgreSQL
COINAGE_POSTGRES_DB="coinage-db"
COINAGE_POSTGRES_USER="postgres"
COINAGE_POSTGRES_PASSWORD=

# API
# Database and API ports are internal only; nginx proxies API/WebSocket requests.
COINAGE_API_JWT_SECRET=
COINAGE_ADMIN_USERNAME="admin"
COINAGE_ADMIN_PASSWORD=

# Webapp
COINAGE_WEBAPP_PORT=4200
