# Docker Compose Project name Override
COMPOSE_PROJECT_NAME="coinage-app"

COINAGE_WEBAPP_PORT=4200
COINAGE_API_PORT=3333

# JWT Login Secret
COINAGE_API_JWT_SECRET="local-development-only"

# Default Admin login created in an empty DB
COINAGE_ADMIN_USERNAME="admin"
COINAGE_ADMIN_PASSWORD="replace-with-unique-local-password"

# Connection details to PostgreSQL Database
COINAGE_POSTGRES_HOST="localhost"
COINAGE_POSTGRES_PORT=5432
COINAGE_POSTGRES_DB="coinage-db-admin"
COINAGE_POSTGRES_USER="postgres"
COINAGE_POSTGRES_PASSWORD="password"
