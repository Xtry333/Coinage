{
    "cli": {
        "packageManager": "yarn"
    },
    "extends": "nx/presets/npm.json",
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "generators": {
        "@nx/angular:application": {
            "style": "scss",
            "linter": "eslint",
            "unitTestRunner": "jest",
            "e2eTestRunner": "cypress"
        },
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "jest"
        },
        "@nx/angular:component": {
            "style": "scss"
        }
    },
    "targetDefaults": {
        "build": {
            "cache": true
        },
        "e2e": {
            "cache": true
        },
        "lint": [
            {
                "filter": {
                    "plugin": "@nx/eslint/plugin"
                },
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/eslint.config.mjs",
                    "{workspaceRoot}/tools/eslint-rules/**/*",
                    {
                        "externalDependencies": ["eslint"]
                    }
                ]
            }
        ],
        "test": [
            {
                "filter": {
                    "plugin": "@nx/jest/plugin"
                },
                "configurations": {
                    "ci": {
                        "ci": true,
                        "coverage": true
                    }
                },
                "options": {
                    "passWithNoTests": true
                }
            }
        ]
    },
    "defaultBase": "master",
    "nxCloudId": "689bc435b0c1aa692565e89c",
    "tui": {
        "enabled": false
    },
    "affected": {
        "legacy": true
    },
    "plugins": [
        {
            "plugin": "@nx/webpack/plugin",
            "include": ["packages/coinage-api/webpack.config.js"],
            "options": {
                "buildTargetName": "build",
                "serveTargetName": "webpack-serve"
            }
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@nx/jest/plugin",
            "options": {
                "targetName": "test"
            }
        },
        {
            "plugin": "@nx/cypress/plugin",
            "options": {
                "targetName": "e2e",
                "ciTargetName": "e2e-ci",
                "componentTestingTargetName": "component-test",
                "openTargetName": "open-cypress"
            }
        }
    ],
    "analytics": false
}
